{
  "expo": {
    "name": "KidEDU",
    "slug": "kidedu",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "kidedu",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-router",
      "expo-asset",
      [
        "expo-audio",
        {
          "microphonePermission": "KidEDU dùng micro để phụ huynh ghi âm mẫu phát âm cho thẻ học.",
          "recordAudioAndroid": true
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "KidEDU dùng camera để phụ huynh quay video khẩu hình cho thẻ học.",
          "microphonePermission": "KidEDU dùng micro để ghi âm khi phụ huynh quay video khẩu hình.",
          "recordAudioAndroid": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "KidEDU cần truy cập ảnh và video để phụ huynh cá nhân hóa thẻ học.",
          "cameraPermission": "KidEDU dùng camera để phụ huynh quay video khẩu hình cho thẻ học.",
          "microphonePermission": "KidEDU dùng micro để ghi âm khi phụ huynh quay video khẩu hình."
        }
      ],
      "expo-sqlite",
      "expo-video",
      "expo-secure-store",
      "expo-font",
      "expo-image",
      "expo-sharing",
      "expo-status-bar"
    ],
    "ios": {
      "bundleIdentifier": "com.kidedu.mobile",
      "buildNumber": "1",
      "supportsTablet": true,
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.kidedu.mobile",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/icon.png",
        "backgroundImage": "./assets/icon.png",
        "monochromeImage": "./assets/icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "favicon": "./assets/icon.png"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "6fa79524-1f1a-48a0-9baf-c87ead583a56"
      }
    },
    "owner": "tnminhngoc"
  }
}
