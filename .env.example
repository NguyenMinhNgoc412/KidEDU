# Local Docker identity fixture is used when Supabase values are absent in development.
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000
EXPO_PUBLIC_LOCAL_IDENTITY_URL=http://localhost:3011
# Opt in only for a private-LAN local Docker lesson fixture (development only).
EXPO_PUBLIC_ENABLE_LOCAL_LESSON_FIXTURE=0

# Physical iPhone/Android: replace localhost in both URLs with the computer's
# Wi-Fi IPv4 address and set KIDEDU_LOCAL_BIND_ADDRESS for Docker Compose.
# See apps/api/README.md for the same-Wi-Fi device setup.

# Fill these for Supabase Auth email/password outside the local fixture.
# Never place a service_role or secret key in an EXPO_PUBLIC variable.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
