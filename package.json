{
  "name": "kidedu",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "packageManager": "pnpm@10.14.0",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "doctor": "expo install --check",
    "check": "pnpm check:default-media && pnpm typecheck && pnpm lint && pnpm test && pnpm test:native",
    "check:api": "pnpm --filter @kidedu/api db:generate && pnpm --filter @kidedu/api typecheck && pnpm --filter @kidedu/api lint && pnpm --filter @kidedu/api test && pnpm --filter @kidedu/api build",
    "generate:api-client": "openapi-typescript apps/api/openapi.local.yaml -o src/api/generated.ts",
    "check:default-media": "node scripts/check-default-media.cjs",
    "check:default-media:release": "node scripts/check-default-media.cjs --require-video",
    "build:android:preview": "node scripts/build-android-local.cjs",
    "build:android:production": "pnpm check && pnpm check:default-media:release && node scripts/build-android-local.cjs --production",
    "build:ios:preview": "eas build --platform ios --profile preview",
    "build:ios:production": "pnpm check && pnpm check:default-media:release && eas build --platform ios --profile production",
    "submit:ios": "eas submit --platform ios --profile production",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "test:native": "jest --config jest.native.config.js --runInBand",
    "test:web": "node scripts/local-web-smoke.cjs",
    "test:web:api": "node scripts/local-api-web-smoke.cjs",
    "test:web:full": "node scripts/local-full-access-web-smoke.cjs",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@expo-google-fonts/plus-jakarta-sans": "^0.4.2",
    "@expo/dom-webview": "~58.0.2",
    "@expo/metro-runtime": "58.0.15",
    "@shopify/flash-list": "^2.3.2",
    "@supabase/supabase-js": "^2.117.2",
    "@tanstack/react-query": "^5.101.2",
    "expo": "~58.0.21",
    "expo-asset": "~58.0.19",
    "expo-audio": "~58.0.10",
    "expo-blur": "~58.0.5",
    "expo-camera": "~58.0.14",
    "expo-constants": "~58.0.14",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.11",
    "expo-image": "~58.0.18",
    "expo-image-manipulator": "~58.0.16",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.15",
    "expo-router": "~58.0.28",
    "expo-secure-store": "~58.0.2",
    "expo-sharing": "~58.0.21",
    "expo-sqlite": "~58.0.14",
    "expo-status-bar": "~58.0.4",
    "expo-video": "~58.0.13",
    "expo-video-thumbnails": "~58.0.2",
    "lucide-react-native": "^1.23.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.80.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-web": "0.21.4",
    "react-native-worklets": "0.13.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@react-native/jest-preset": "^0.88.1",
    "@react-native/metro-config": "0.88.1",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.3.0",
    "eslint": "^10.6.0",
    "jest": "^30.5.2",
    "jest-expo": "~58.0.13",
    "openapi-typescript": "7.10.1",
    "playwright": "1.63.0",
    "prettier": "^3.9.4",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.62.1"
  }
}
