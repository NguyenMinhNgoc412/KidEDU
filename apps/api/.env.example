# Copy to a private environment configuration for staging or production.
# Local Docker Compose supplies its own synthetic values; no file is needed there.
APP_ENV=staging
# Keep legacy word-game creation/awards closed during C50 rollout and rollback.
C50_DAILY_GAMES_CUTOVER=1
# Synthetic content is never permitted outside APP_ENV=local.
C50_LOCAL_DAILY_FIXTURE=0
PORT=3000
DATABASE_POOL_URL=postgresql://USER:PASSWORD@POOLER_HOST:6543/kidedu?schema=public
DATABASE_MIGRATION_URL=postgresql://USER:PASSWORD@DIRECT_OR_SESSION_HOST:5432/kidedu?schema=public
SUPABASE_JWKS_URL=https://YOUR_PROJECT.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_ISSUER=https://YOUR_PROJECT.supabase.co/auth/v1
SUPABASE_JWT_AUDIENCE=authenticated
CHILD_PROFILE_CONSENT_VERSION=SET_APPROVED_VERSION
LOG_LEVEL=info
R2_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
R2_BUCKET=YOUR_PRIVATE_BUCKET
R2_ACCESS_KEY_ID=SET_ACCESS_KEY_ID
R2_SECRET_ACCESS_KEY=SET_SECRET_ACCESS_KEY
