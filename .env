# Expo CLI 54 can crash on Node 22 while fetching remote native module versions.
# Keep dev startup local-first and skip that non-runtime dependency doctor step.
EXPO_NO_DEPENDENCY_VALIDATION=1
EXPO_PUBLIC_API_BASE_URL=http://192.168.1.9:3000
EXPO_PUBLIC_LOCAL_IDENTITY_URL=http://192.168.1.9:3011
EXPO_PUBLIC_ENABLE_LOCAL_LESSON_FIXTURE=1
